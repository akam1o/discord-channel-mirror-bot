# Copy to .env and fill in your values.
#
# IMAGE can be either:
# - local image name (e.g. "discord-channel-mirror-bot" after docker build)
# - GHCR image (e.g. "ghcr.io/akam1o/discord-channel-mirror-bot:latest")
IMAGE=ghcr.io/akam1o/discord-channel-mirror-bot:latest

SOURCE_CHANNEL_ID=
SOURCE_DISCORD_BOT_TOKEN=
TARGET_CHANNEL_ID=
TARGET_DISCORD_BOT_TOKEN=
